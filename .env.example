# Postgres connection string. Vercel adds this for you when you connect a Neon database.
DATABASE_URL=

# Any random string of 32+ characters. Encrypts the ServiceM8 key and the Xero sign-in. Never change it once connected.
ENCRYPTION_KEY=

# Any random string. You type it once on /setup to create the first admin login.
SETUP_TOKEN=

# The address people use to reach the app, with no trailing slash.
APP_URL=https://reports.your-domain.example

# From the app you register at developer.xero.com, with redirect URI <APP_URL>/api/xero/callback.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Any random string of 16+ characters. Vercel Cron sends it to /api/cron/sync to refresh ServiceM8 and Xero.
CRON_SECRET=
